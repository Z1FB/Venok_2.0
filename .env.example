# Copia este archivo como ".env" (sin ".example") y pon tu clave real ahí.
# El archivo ".env" NUNCA debe compartirse ni subirse a internet.

ELEVENLABS_API_KEY=tu_clave_aqui
WOLFRAM_APP_ID=tu_clave_aqui
ANTHROPIC_API_KEY=tu_clave_aqui

# YouTube Data API v3 (opcional). Sin esta clave Venok no reproduce
# videos directamente: solo abre la página de resultados.
YOUTUBE_API_KEY=tu_clave_aqui

# Correo (opcional). La contraseña es una "contraseña de aplicación" de
# Gmail, no la de tu cuenta: https://myaccount.google.com/apppasswords
CORREO_USUARIO=tucorreo@gmail.com
CORREO_PASSWORD=tu_contrasena_de_aplicacion
